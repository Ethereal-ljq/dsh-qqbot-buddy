{
  "name": "dsh-qqbot-buddy",
  "version": "1.0.0-rc.1",
  "description": "DSH（DeepSeek Harness）QQ 官方机器人插件：自带管理控制台、多机器人隔离、配置档、工具与技能、SQLite 记忆/知识库、群日报、语音 TTS/ASR",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Ethereal-ljq/dsh-qqbot-buddy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethereal-ljq/dsh-qqbot-buddy.git"
  },
  "bugs": {
    "url": "https://github.com/Ethereal-ljq/dsh-qqbot-buddy/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "qqbot",
    "qq-bot",
    "bot",
    "agent",
    "plugin",
    "console",
    "memory",
    "knowledge-base",
    "sqlite",
    "tts",
    "asr"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./console": "./lib/console/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node --test test/*.test.js",
    "verify:recall": "node scripts/verify-recall.mjs",
    "verify:standalone": "node scripts/verify-standalone-install.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "console:build": "npm --prefix web run build",
    "console:dev": "npm --prefix web run dev",
    "dev:console": "node scripts/dev-console.mjs",
    "template:install": "node scripts/install-template.mjs",
    "install:local": "node scripts/install.mjs --local --spec .",
    "install:plugin": "node scripts/install.mjs",
    "build:web": "npm --prefix web run build"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "bin": {
    "dsh-qqbot-buddy-install": "scripts/install.mjs"
  },
  "files": [
    "lib/**",
    "web/dist/**",
    "custom/templates/**",
    "!custom/templates/anime/**",
    "docs/**",
    "!docs/images/**",
    "!docs/SCREENSHOTS.md",
    "!docs/PLAN-*.md",
    "!docs/FEASIBILITY-*.md",
    "scripts/**",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
