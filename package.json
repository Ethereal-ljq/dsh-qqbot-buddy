{
  "name": "dsh-qqbot-buddy",
  "version": "1.0.0-alpha.0",
  "description": "DSH QQ 机器人插件 v2：独立管理控制台、配置档/会话级配置、可管理的工具与技能、SQLite+FTS5 记忆与知识库",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./console": "./lib/console/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "console:build": "npm --prefix web run build",
    "console:dev": "npm --prefix web run dev",
    "setup:dev": "node scripts/setup-dev.mjs"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
