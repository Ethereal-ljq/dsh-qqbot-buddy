{
  "name": "dsh-qqbot-buddy",
  "version": "1.0.0-alpha.5",
  "description": "DSH QQ 机器人插件 v2：自包含管理控制台、配置档/会话级配置、可管理的工具与技能、SQLite+FTS5 记忆与知识库",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Ethereal-ljq/dsh-qqbot-buddy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethereal-ljq/dsh-qqbot-buddy.git"
  },
  "bugs": {
    "url": "https://github.com/Ethereal-ljq/dsh-qqbot-buddy/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "qqbot",
    "qq",
    "agent",
    "plugin"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./console": "./lib/console/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node --test test/*.test.js",
    "verify:recall": "node scripts/verify-recall.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "console:build": "npm --prefix web run build",
    "console:dev": "npm --prefix web run dev",
    "dev:console": "node scripts/dev-console.mjs",
    "install:local": "node scripts/install.mjs --local --spec .",
    "install:plugin": "node scripts/install.mjs",
    "build:web": "npm --prefix web run build"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-qqbot-buddy-install": "scripts/install.mjs"
  },
  "files": [
    "lib/**",
    "web/dist/**",
    "docs/**",
    "scripts/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
